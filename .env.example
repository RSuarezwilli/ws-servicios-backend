# Copia este archivo a ".env" y llena tus datos reales.
# El archivo ".env" NUNCA se debe subir a un repositorio público.

PORT=3000

# Genera una clave aleatoria para el panel:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# En Render, apunta al disco persistente configurado en render.yaml.
# En local, déjalo vacío para guardar "solicitudes.json" junto al servidor.
SOLICITUDES_FILE=

# Configuración de correo (opcional al inicio).
# Si usas Gmail: activa la verificación en dos pasos y genera una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# A qué correo te llegan las notificaciones de nuevas solicitudes.
NOTIFY_EMAIL=tucorreo@gmail.com
